  "narrative": {
    "northStar": "L'Arène",
    "overview": "The festival is built around a real equestrian sport, so the sport carries the identity: a barrel turn in the dust, the cloverleaf pattern around three barrels, the chrono, and a name set as large as a grandstand banner. Everything else stays quiet so that one gesture reads. The page moves through a festival day: sand while the competition runs, night when the Grand Prix and the shows begin under the tent, sand again for the families the next morning.\n\nThe world refuses the category default of western festivals: no boots, skulls or guitars as wallpaper, no saloon lettering, no orange-and-brown everything, no popups. The premium comes from restraint and finish: one variable family used at its extremes, square corners, 1px rules, photographs graded warm and slightly desaturated, and motion that only happens where it explains something.",
    "keyCharacteristics": [
      "One giant word per moment, fitted exactly to the measure.",
      "The width axis of a single family carries the brand: wide for momentum, condensed for times.",
      "Sand and night as the only two grounds; barrel red for action only.",
      "Real festival photographs, cut and layered for depth, never stock.",
      "The cloverleaf course as the page's thread, from « Départ » to « Arrivée »."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Rouge baril is used for action, for the course line and for the single evening highlight. Never for decoration, never as a background field larger than a button or a flag.",
        "section": "colors"
      },
      {
        "name": "The Day and Night Rule",
        "body": "A section is sand or night, never both. The only transition is narrative: the programme turns to night when the selected day reaches its evening events.",
        "section": "colors"
      },
      {
        "name": "The Fitted Word Rule",
        "body": "A display word fills the measure exactly; its size comes from its measured width, never from a guess. Phones switch to wdth 75 rather than shrinking.",
        "section": "typography"
      },
      {
        "name": "The No Kicker Rule",
        "body": "No small label above a heading. Dates, places and categories sit after the title or in a side column.",
        "section": "typography"
      },
      {
        "name": "The Real Depth Rule",
        "body": "Depth is made from the photograph itself (cut-outs, planes, parallax), never from bevels, glows or imitation materials.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do fit display words to the measure from their measured width.",
      "Do use real festival photographs, graded warm and slightly desaturated.",
      "Do keep red for action, the course line and the single programme highlight.",
      "Do keep content visible without JavaScript and under reduced motion.",
      "Do label any provisional content (programme preview, 2027 dates)."
    ],
    "donts": [
      "Don't use western clip-art patterns (boots, skulls, guitars, horseshoes) as decoration.",
      "Don't put a small label above a heading.",
      "Don't add a second accent colour or a gradient on text.",
      "Don't round corners on cards, tiles or buttons.",
      "Don't invent partners, artists, figures or testimonials."
    ]
  }
}