{
  "name": "festival-gymkhana-falardeau",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/defer-hydration.mjs && node scripts/flatten-rsc.mjs && node scripts/write-redirects.mjs",
    "start": "npx serve out",
    "deploy": "npm run build && npx -y wrangler@4 deploy",
    "lint": "tsc --noEmit && eslint .",
    "images": "node scripts/build-images.mjs",
    "map": "node scripts/build-map.mjs",
    "texture": "node scripts/build-texture.mjs",
    "icons": "node scripts/build-icons.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "deploy:staging": "npm run build && npx -y wrangler@4 deploy --env staging"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "12.8.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
